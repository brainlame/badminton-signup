---
import QueueApp from '../components/QueueApp';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>CMU Badminton Queue</title>
	</head>
	<body class="bg-gray-100 min-h-screen">
		<div class="container mx-auto px-4 py-8 max-w-7xl">
			<header class="text-center mb-8">
				<h1 class="text-4xl font-bold text-gray-800 mb-2">CMU Badminton Open Gym</h1>
				<p class="text-gray-600">Sign up to a court and a group number in the form at the bottom of the page. Each game will be played to 21 points, then the next group in queue will rotate onto court. </p>
			</header>

			<main>
				<div id="app-loading" class="flex justify-center items-center py-12">
					<div class="text-gray-600">Loading...</div>
				</div>
				<QueueApp client:only="react" />
			</main>

			<!-- <footer class="text-center mt-12 text-sm text-gray-500">
				<a href="/admin" class="hover:text-gray-700 underline">Admin Login</a>
			</footer> -->
		</div>
	</body>
</html>
